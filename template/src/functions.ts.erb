<%=
Gen.output.config = Gen.x.cfg['ts_indentation']
Gen.x.generator_info
%>

import type {String2String, CallExtras, <%= [].concat(Gen.x.types.types, Gen.x.types.interfaces).sort!.join(', ')%>} from './types';
<%=
names = [].concat(Gen.x.types.consts, Gen.x.types.functions).sort!.join(', ')
names.empty? ? '// Nothing else from ./types' : "import {#{names}} from './types';"
%>
import {addJsonHeaders,addJsonBody,str2integer,str2float} from './helpers';
import {OperationIdIndex, operationIdUrls} from './server';

// Functions to call specific path with given CallSomething parameter.
// Optional parameter extras that has headers, parameters, query. All objects.
// Optional function that takes maybe a Request object and can modify it.
// Pass all as single object to get named parameters.


// Functions that take parameter objects and provide the full URL to be given to
// the function that sets the server URL.

// Can modify url and return the new or old string. Can modify ri.
export type RequestInitModifier = (url: string, ri: RequestInit) => string;

<%=
out = []
# Pull security and then securitySchemes and figure out headers.
Gen.doc['paths'].each do |path, path_item_object|
  oos = OpenAPISourceTools::ApiObjects.operation_objects(path_item_object)
  oos.each do |method, operation_object|
    id = operation_object['operationId']
    operation_object[:func_name] = id
    parameterless = operation_object[:parameterless]
    # Inner-most exported function takes straight params, modifier, produces Response.
    # Outer exported functions perform known handling.
    # Response body decoding can be from any known format.
    # Support JSON both directions.
    # Similar function can then be used for HTTP Message Signature, for example.
    # Status code 3xx would need special handling.
    # What if status code to handler mapping were provided?
    # User can provide their own handlers. Handler mapping does not have state so reusable?
    # Handler can fail, succeed, or take action such as redirect?
    # What if status code handling function were provided? Internally can be anything.
    # Default handler can be provided. Caller can wrap it in own handler for specifics.
    # 
    # Response object types need to be added.
    # Even if 20x are return values and other thrown, the return type needs to have
    # the status code so that correct member can be accessed.
    # Seems like status code and then all optional members are what covers it.
    # The member naming is the only ambiguous decision.
    # If I leave body encoding outside the call, then response coding is outside it as well.
    
    # This is the lowest-level function.
    ps = operation_object[:paraschemas].map { |x| x[:param] }
    path_params = ps.select { |p| p['in'] == 'path' }
    path_params.sort_by! { |x| x['name'] }
    header_params = ps.select { |p| p['in'] == 'header' }
    header_params.sort_by! { |x| x['name'] }
    query_params = ps.select { |p| p['in'] == 'query' }
    query_params.sort_by! { |x| x['name'] }
    req_body = operation_object['requestBody']
    req = (req_body || {}).fetch('required', false)
    base_aname = "Args#{LuckyCase.pascal_case(operation_object[:func_name])}"
    out.concat([
"export interface #{base_aname} {
  #{parameterless ? '// No parameters.' : "params: #{operation_object[:call_name]},"}
  extras?: CallExtras,
  modifier?: RequestInitModifier
};

export async function #{operation_object[:func_name]}(args: #{base_aname}): Promise<Response> {",
      true,
      path_params.empty? ? "const path = '#{path}';" :
"let path;
if (args.extras && args.extras.parameters) {
  #{path_params.map { |p| "const #{p['name']} = encodeURIComponent(args.extras.parameters.#{p['name']} || args.params.#{p['name']});"}.join("\n  ")}
  path = `#{path.gsub('{', '${')}`;
} else {
  #{path_params.map { |p| "const #{p['name']} = encodeURIComponent(args.params.#{p['name']});"}.join("\n  ")}
  path = `#{path.gsub('{', '${')}`;
}",
"let query = '';
if (args.extras && args.extras.query) {
  const qp = {",
      query_params.empty? ? nil : query_params.map { |p| "'#{p['name']}': args.params.#{p['name']},"}.join("\n"),
"    ...args.extras.query
  };
  let sep = '?';
  const keys = Object.keys(qp);
  for (const k of keys) {
    query += `${sep}${k}=${encodeURIComponent(qp[k])}`;
    sep = '&';
  }",
      query_params.empty? ? nil : "} else {
  #{query_params.map { |p| "const #{p['name']} = encodeURIComponent(args.params.#{p['name']};"}.join("\n")}
  query = `?#{query_params.map! { |p| "#{p['name']}=${#{p['name']}}"}.join('&')}`;",
      "}
let url = `${operationIdUrls[OperationIdIndex.#{operation_object['operationId']}]}${path}${query}`;
const ri: RequestInit = {
  method: '#{method.upcase}'
  // Add default values form configuration if present during code generation.
};",
      header_params.empty? ?
"if (args.extras && args.extras.headers) {
  ri.headers = args.extras.headers;
}" :
"if (args.extras && args.extras.headers) {
  ri.headers = {
    #{header_params.map! { |p| "'#{p['name']}': args.params.#{p['name']}," }.join("\n")}
    ...args.extras.headers
  };
} else {
  ri.headers: {
    #{header_params.map! { |p| "'#{p['name']}': args.params.#{p['name']}" }.join(",\n")}
  }
}",
      req_body ? "#{req ? '' : 'if (args.params.body) '}ri.body = args.params.body;" : nil,
      'if (args.modifier)
  url = args.modifier(url, ri);
return fetch(url, ri);',
      false,
      '}',
      ''
    ])
    # URL + UrlSearchParams( /* query params from params and query from extras. */ )

    # A higher-level convenience function to call the previous. Per type.
    req_body = operation_object['requestBody']
    if req_body
      req = req_body.fetch('required', false)
      content = req_body['content']
      content.each do |media_type, mto|
        mt = mto[:name]
        next if mt.nil?
        call_name = mto[:call_name]
        aname = "Args#{LuckyCase.pascal_case(operation_object[:func_name])}#{mt}"
        if media_type == 'application/json'
          s = <<EOB
// Convenience function to pass JSON-encoded body to #{operation_object[:func_name]}.
export interface #{aname} {
  params: #{call_name},
  extras?: CallExtras,
  modifier?: RequestInitModifier
}

export function #{operation_object[:func_name]}#{mt}(args: #{aname}): Promise<Response> {
  const a: #{base_aname} = {
    extras: args.extras || { headers: {} },
    params: #{req ? '{ ...args.params, body: JSON.stringify(args.params.body) }' : 'args.params'}
  };
  if (args.modifier)
    a.modifier = args.modifier;
  if ((a.extras as CallExtras).headers === undefined)
    (a.extras as CallExtras).headers = {};
  #{req ? 'addJsonHeaders(' : 'addJsonBody(a.params, '}a.params.body, (a.extras as CallExtras).headers as String2String);
  return #{operation_object[:func_name]}(a);
}
EOB
          out.push(s)
        end
      end
    end

    # Response handling is another function.
    unbundled = []
    resps = operation_object['responses'] || {}
    codes = Gen.h.response_codes(resps)
    has_default = codes.last == 'default'
    return_types = {}
    codes.each do |code|
      response = Gen.h.dereference(resps[code])

      # Return value could be a type that has code, optional fields for all applicable types.
      # Perhaps name of the field that has the value.
      # Could have response if nothing was done.
      unbundled.push({
        cond: (code == 'default') ? 'true' : Gen.h.response_code_condition(code),
        resp: response # Has content and headers, contents have matching type in mto[:type_name]
      })
      content = response['content']
      if content.nil?
        return_types[response[:name]] = LuckyCase.camel_case(response[:name])
      else
        content.each do |media_type, mto|
          t = mto[:type_name]
          return_types[t] = LuckyCase.camel_case(t) unless t.nil?
        end
      end
    end

    # return_types could be used to make an interface that has all needed fields
    # and that is then returned.

    # Bundle all consecutive cases that have the same response.
    parts = []
    unbundled.each do |cr|
      if parts.empty?
        parts.push({
          cond: [ cr[:cond] ],
          resp: cr[:resp]
        })
        next
      end
      if parts.last[:resp].object_id == cr[:resp].object_id
        parts.last[:cond].push(cr[:cond])
      else
        parts.push({
          cond: [ cr[:cond] ],
          resp: cr[:resp]
        })
      end
    end

    # Return response body as handled. Use Blob when uncertain, retains MIME type.
    # For JSON use Response.json(), and for other stuff similar methods.
    pieces = [ true ]
    parts.each do |cr|
      cond = cr[:cond].join(' || ')
      response = cr[:resp]
      unless response.key?('headers') || response.key?('content') # 204 maybe.
        pieces.concat([
          "if (#{cond}) { // #{response[:name]}",
          true,
          'return { code: code, response: r };',
          false,
          '}'
        ])
        next
      end
      content = response['content']
      name2type = (response['headers'] || {})[:name2type] || {}
      header_field_lines = name2type.keys.sort!.map do |h|
        n2t = name2type[h]
        check = n2t[:schema][:check]
        n = Gen.h.dereference(n2t[:schema])[:native]
        if n.nil?
          "#{n2t[:name]}: #{check || ''}(r.headers.get('#{h}'))"
        elsif n == :integer
          "#{n2t[:name]}: #{check || ''}(str2integer(r.headers.get('#{h}')))"
        elsif n == :float
          "#{n2t[:name]}: #{check || ''}(str2float(r.headers.get('#{h}')))"
        else
          raise StandardError, "Unhandled native type header value assignment: #{n}"
        end
      end
      pieces.concat([
        "if (#{cond}) { // #{response[:name]}",
        true
      ])
      if content.nil? # No body.
        rn = return_types[response[:name]]
        if name2type.size == 1 # Only one header value.
          pieces.push("return { code: code, response: r, valid: '#{rn}', #{rn}: { #{header_field_lines.first} }) };")
        elsif name2type.size > 1 # Multiple header values.
          pieces.concat([
            "return { code: code, response: r, valid: '#{rn}', #{rn}: {",
            true,
            header_field_lines.join(",\n"),
            false,
            '}};'
          ])
        end
      else # Body.
        alts = []
        content.each do |media_type, mto|
          t = mto[:type_name]
          next if t.nil?
          rn = LuckyCase.camel_case(t)
          s = Gen.h.dereference(mto['schema'])
          check = s[:check]
          body_val = case mto[:name]
          when 'Json' then "#{check || ''}(await r.json())"
          when 'Blob' then 'await r.blob()'
          when 'Text' then 'await r.text()'
          else raise StandardError, "Unhandled type suffix in body assignment: #{mto[:name]}"
          end
          if header_field_lines.empty? # Only body.
            alts.concat([
              "if (mt === '#{media_type}') { // #{t}",
              true,
              "return { code: code, response: r, valid: '#{rn}', #{rn}: { body: #{body_val} } };",
              false,
              '}'
            ])
          else # Body and header values.
            alts.concat([
              "if (mt === '#{media_type}') { // #{mto[:type_name]}",
              true,
              "return { code: code, response: r, valid: '#{rn}', #{rn}: {",
              true,
              "body: #{body_val},",
              header_field_lines.join(",\n"),
              false,
              '}};',
              false,
              '}'
            ])
          end
        end
        unless alts.empty?
          pieces.push("const mt = r.headers.get('Content-Type');")
          pieces.concat(alts)
        end
      end
      pieces.concat([
        false,
        '}'
      ])
    end
    pieces.push('return { code: code, response: r };') unless has_default
    tn = "#{LuckyCase.pascal_case(operation_object[:func_name])}Response"
    s = <<EOB
export interface #{tn} {
  code: number;
  valid?: string;
  response: Response;
#{return_types.keys.sort!.map { |t| "  #{return_types[t]}?: #{t};"}.join("\n")}
}

export async function #{operation_object[:func_name]}Response(r: Response): Promise<#{tn}> {
  const code = r.status;
#{Gen.output.join(pieces)}
}
EOB
    out.push(s)
    # Convert security objects into needed headers and such.
    # Security alternatives produce multiple alternatives.
    # Either as separate interfaces or a member can have multiple types.
    # Or multiple members and they are all optional.
    # Presence of {} in security implies missing all is not an issue.

    # Top-level security objects should be declared separately and
    # the have room for flows when applicable.
    # Flow objects could be declared.

    # Function to fetch takes parameter, security object, and types of latter get
    # defined here.

    # In case security schemas are unknown, add a member that takes path, query, and header
    # parameters in sub-objects and caller can assign things as required.
    # In case something like HTTP Message Signature is used, other headers must be
    # allowed.
  end
end
Gen.output.join(out)
%>
