<%=
Gen.output.config = Gen.x.cfg['ts_indentation']
Gen.x.generator_info
%>

// Interfaces and checker functions, and types.
<%=
out = []
checker = []
sis = Gen.x.order
sis.each do |si|
  si.schema[:name] = si.name # For use later.
  comment = [ si.schema['summary'], si.schema['description'] ].compact!
  unless comment.empty?
    s = <<EOB
/* #{si.name}:
#{comment.join("\n\n")}
*/
EOB
    out.push(s)
  end
  case si.schema['type']
  when 'object'
    props = si.schema['properties']
    if props.nil?
      Gen.x.types.types.push(si.name)
      s = "export type #{si.name} = object;"
    else
      reqd = si.schema['required'] || []
      o = [ true ]
      props.keys.sort!.each do |name|
        p = props[name]
        t = Gen.h.category_and_name(p)
        t = t.nil? ? p['type'] : t.last
        o.push("#{name}#{reqd.include?(name) ? '' : '?'}: #{t};")
      end
      Gen.x.types.interfaces.push(si.name)
      s = <<EOB
export interface #{si.name} {
#{Gen.output.join(o)}
}
EOB
    end
    out.push(s)
  when 'array'
    # Supports either ref or simple type without anything else.
    t = Gen.h.category_and_name(si.schema['items'])
    t = t.nil? ? si.schema['items']['type'] : t.last
    out.push("export type #{si.name} = Array<#{t}>;")
    Gen.x.types.types.push(si.name)
  when 'string'
    Gen.x.types.types.push(si.name)
    out.push("export type #{si.name} = string;")
    checks = {
      'minLength' => "if (value.length < #{si.schema['minLength']}) throw new Error(`#{si.name} length ${value.length} < #{si.schema['minLength']}`);",
      'maxLength' => "if (value.length > #{si.schema['maxLength']}) throw new Error(`#{si.name} length ${value.length} > #{si.schema['maxLength']}`);",
      'pattern' => "if (!re#{si.name}.test(value)) throw new Error('#{si.name} value does not match pattern #{si.schema['pattern']}');"
    }
    re = si.schema.key?('pattern') ? "const re#{si.name} = new RegExp('#{si.schema['pattern']}');" : nil
    present = checks.keys.map { |k| si.schema.key?(k) ? checks[k] : nil }.compact
    unless present.empty?
      out.push(re) unless re.nil?
      si.schema[:check_func] = "check#{si.name}"
      Gen.x.types.functions.push(si.schema[:check_func])
      s = <<EOB
export function #{si.schema[:check_func]}(value: string): #{si.name} {
  #{present.join("\n  ")}
  return value as #{si.name};
}
EOB
      out.push(s)
    end
  when 'integer', 'number'
    si.schema[:native] = si.schema['type'] == 'integer' ? :integer : :float
    Gen.x.types.types.push(si.name)
    out.push("export type #{si.name} = number;")
    checks = {
      'multipleOf' => "if (value % #{si.schema['multipleOf']} !== 0) throw new Error(`#{si.name} value ${value} not a multiple of #{si.schema['multipleOf']}`);",
      'minimum' => "if (value < #{si.schema['minimum']}) throw new Error(`#{si.name} value ${value} < #{si.schema['minimum']}`);",
      'maximum' => "if (value > #{si.schema['maximum']}) throw new Error(`#{si.name} value ${value} > #{si.schema['maximum']}`);",
      'exclusiveMinimum' => "if (value <= #{si.schema['exclusiveMinimum']}) throw new Error(`#{si.name} value ${value} <= #{si.schema['exclusiveMinimum']}`);",
      'exclusiveMaximum' => "if (value >= #{si.schema['exclusiveMaximum']}) throw new Error(`#{si.name} value ${value} >= #{si.schema['exclusiveMaximum']}`);",
    }
    present = checks.keys.map { |k| si.schema.key?(k) ? checks[k] : nil }.compact
    unless present.empty?
      si.schema[:check_func] = "check#{si.name}"
      Gen.x.types.functions.push(si.schema[:check_func])
      s = <<EOB
export function #{si.schema[:check_func]}(value: number): #{si.name} {
  #{present.join("\n  ")}
  return value as #{si.name};
}
EOB
      out.push(s)
    end
  when 'boolean'
    Gen.x.types.types.push(si.name)
    out.push("export type #{si.name} = boolean;")
  else
    raise StandardError, "Unhandled type: #{si.schema['type']} #{si.schema}"
  end
  out.push('')
end
Gen.output.join(out)
%>

// Security requirement types.
<%=
require 'lucky_case'

out = []
secs = Gen.doc.dig('components', 'securitySchemes')
if secs.nil?
  out.push('// No security schemes.')
else
  has_apikey = false
  secs.each do |sname, scheme|
    desc = scheme['description']
    unless desc.nil?
      desc.strip!
      if desc.lines.size < 2
        out.push("// #{desc}")
      else
        out.push("/*\n#{desc}\n*/")
      end
    end
    # The configuration should allow a drop-in type as multi-line text.
    case scheme['type'].downcase
    when 'apikey'
      next if has_apikey
      has_apikey = true
      scheme[:name] = "SecurityApiKey"
      Gen.x.types.types.push(scheme[:name])
      out.push("export type #{scheme[:name]} = string;")
    when 'http'
      scheme[:name] = "SecurityHttp#{LuckyCase.pascal_case(sname)}"
      Gen.x.types.types.push(scheme[:name])
      out.push("export type #{scheme[:name]} = Object;")
    when 'oauth2'
      # Produce a constant object that contains all data as is.
      scheme[:name] = "SecurityOAuth2#{LuckyCase.pascal_case(sname)}"
      Gen.x.types.consts.push(scheme[:name])
      out.push("export const #{scheme[:name]} = #{JSON.pretty_generate(scheme['flows'])}")
    when 'openidconnect'
      # Produce a constant object that contains all data as is.
      scheme[:name] = "SecurityOpenIdConnect#{LuckyCase.pascal_case(sname)}"
      Gen.x.types.consts.push(scheme[:name])
      out.push("export const #{scheme[:name]} = #{JSON.pretty_generate(scheme['openIdConnectUrl'])};")
    else
      msg = "Unhandled security scheme type: #{scheme['type']}"
      out.push("// #{msg}")
      warn(msg)
    end
  end
end
Gen.output.join(out)
%>

// Types for making requests.

export interface String2String {
  [index: string]: string;
}

// Type for passing extra parameters in addition to function call parameters.
export interface CallExtras {
  parameters?: String2String;
  headers?: String2String;
  query?: String2String;
}

// Types containing function call parameters.

<%=
ok_suffix = Regexp.new('[[:alnum:]_]+')
out = []
schemes = Gen.doc.dig('components', 'securitySchemes')
Gen.doc['paths'].each do |path, path_item_object|
  oos = OpenAPISourceTools::ApiObjects.operation_objects(path_item_object)
  oos.each do |method, operation_object|
    paraschemas = (operation_object['parameters'] || []).map do |pref|
      p = Gen.h.dereference(pref)
      s = Gen.h.dereference(p['schema'])
      {
        param: p,
        schema: s
      }
    end
    operation_object[:paraschemas] = paraschemas
    # Get all common fields and then create all body-type specific variations
    # using it to ensure the fields remain the same.
    common = []
    common.push('// Parameters:')
    paraschemas.each do |ps|
      p = ps[:param]
      common.push("#{p['name']}#{p['required'] ? '' : '?'}: #{ps[:schema][:name]};")
    end
    common.pop unless common.last.end_with?(';') # Remove comment if no parameters.
    common.push('// Security-related:')
    secs = operation_object['security']
    optional = secs.size > 1 || !(secs.find { |s| s.empty? }).nil?
    secs.push({}) if secs.empty?
    used = Set.new
    secs.each do |s|
      next if s.empty?
      s.keys.sort!.each do |sname|
        next if used.include?(sname)
        used.add(sname)
        scheme = schemes[sname]
        common.push("#{sname}#{optional ? '?' : ''}: #{scheme[:name]};")
      end
    end
    common.pop unless common.last.end_with?(';') # Remove comment if no security members.
    req_body = operation_object['requestBody']
    if !req_body && common.empty? # Takes nothing whatsoever.
      out.push("// No parameters for #{operation_object['operationId']}.")
      operation_object[:parameterless] = true
      next
    end
    # Add metadata to :call_type for each name and in for simplicity in index.ts.erb?
    operation_object[:call_name] = LuckyCase.pascal_case(operation_object['operationId'])
    # Lowest-level call interface.
    Gen.x.types.interfaces.push(operation_object[:call_name])
    out.concat([
      "export interface #{operation_object[:call_name]} {",
      true
    ], common)
    out.push("body#{req_body.fetch('required', false) ? '' : '?'}: any;") if req_body
    out.push(false)
    out.push('}')
    out.push('')
    if req_body
      req = req_body.fetch('required', false)
      schema = req_body[:schema]
      content = req_body['content']
      content.each do |media_type, mto|
        # Support text/* and use Response.text?
        # If any unsupported types, provide Blob alternative?
        mt = media_type.downcase
        if mt == 'application/json'
          type_suffix = 'Json'
        elsif mt == 'application/octet-stream'
          type_suffix = 'Blob'
        elsif mt.start_with?('text/')
          type_suffix = 'Text'
        else
          out.push("// No response special-case support for #{media_type}")
          next
        end
        next unless ok_suffix.match(type_suffix)
        mto[:name] = type_suffix
        mto[:call_name] = "#{operation_object[:call_name]}#{mto[:name]}"
        s = Gen.h.dereference(mto['schema'])
        Gen.x.types.interfaces.push(mto[:call_name])
        out.concat([
          "// Convenience #{operation_object['operationId']} type for #{media_type}",
          "export interface #{mto[:call_name]} {",
          true,
          "body#{req ? '' : '?'}: #{s[:name]};"
        ], common, [
          false,
          '}',
          ''
        ])
      end
    end
  end
end
Gen.output.join(out)
%>

// Types containing Response information.

<%=
ok_suffix = Regexp.new('[[:alnum:]_]+')
ignore = %w[content-type] # Get from configuration.
out = []
Gen.doc.dig('components', 'responses').each do |name, response|
  unless response.key?('headers') || response.key?('content')
    response[:name] = 'boolean'
    next
  end
  response[:name] = "#{LuckyCase.pascal_case(name)}Response"
  headers = response['headers'] || {}
  remain = headers.keys.reject { |h| ignore.include?(h.downcase) }
  name2type = {}
  remain.each do |h|
    s = Gen.h.dereference(headers[h])['schema']
    name2type[h] = {
      name: LuckyCase.camel_case(h),
      type: Gen.h.dereference(s)[:name],
      schema: s
    }
  end
  headers[:name2type] = name2type
  common = remain.empty? ? [] : [ '// Headers. ' ].concat(remain.map { |h| "#{name2type[h][:name]}: #{name2type[h][:type]}|null;" })
  content = response['content']
  if content.nil?
    # Output type containing headers.
    # If single header, use that schema directly.
    if remain.size == 1
      response[:name] = Gen.h.dereference(Gen.h.dereference(headers[remain.first])['schema'])[:name]
    elsif remain.size > 1
      Gen.x.types.interfaces.push(response[:name])
      out.concat([
        "export interface #{response[:name]} {",
        true,
      ], common, [
        false,
        '}',
        ''
      ])
    end
    next
  end
  # A raw body content with header fields.
  Gen.x.types.interfaces.push(response[:name])
  out.concat([
    "export interface #{response[:name]} {",
    true,
    'body: any;'
  ], common, [
    false,
    '}',
    ''
  ])
  # Then supported convenience response handlers.
  content.each do |media_type, mto|
    mt = media_type.downcase
    # Alternatives should come from configuration.
    # Supply exact, prefix, pattern. Map to Hash with type suffix and body type.
    if mt == 'application/json'
      type_suffix = 'Json'
      body_type = nil
    elsif mt == 'application/octet-stream'
      type_suffix = 'Blob'
      body_type = 'Blob'
    elsif mt.start_with?('text/')
      type_suffix = 'Text'
      body_type = 'string'
    else
      out.push("// No response special-case support for #{media_type}")
      next
    end
    next unless ok_suffix.match(type_suffix)
    mto[:name] = type_suffix
    mto[:type_name] = "#{response[:name]}#{type_suffix}"
    s = Gen.h.dereference(mto['schema'])
    body_type = s[:name] if body_type.nil?
    Gen.x.types.interfaces.push(mto[:type_name])
    out.concat([
      "// Convenience response type for #{media_type}.",
      "export interface #{mto[:type_name]} {",
      true,
      "body: #{body_type};",
    ], common, [
      false,
      '}',
      ''
    ])
  end
end
Gen.output.join(out)
%>
